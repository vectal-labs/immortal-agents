<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.immortal-agents.netguard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/operator/code/immortal-agents/launchd/netguard.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>WATCHER_STATE_DIR</key>
		<string>/Users/operator/.immortal-agents</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/operator/.immortal-agents/netguard.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/operator/.immortal-agents/netguard.stderr.log</string>
</dict>
</plist>
