+//! Responses socket I/O and transport liveness, independent of model-message idle timeouts.
+
+use bytes::Bytes;
+use codex_http_client::NetworkChange;
+use futures::Sink;
+use futures::SinkExt;
+use futures::Stream;
+use futures::StreamExt;
+use std::io;
+use std::time::Duration;
+use tokio::sync::mpsc;
+use tokio::sync::oneshot;
+use tokio::sync::watch;
+use tokio::time::Instant;
+use tokio_tungstenite::tungstenite::Error as WsError;
+use tokio_tungstenite::tungstenite::Message;
+use uuid::Uuid;
+
+const PROBE_INTERVAL: Duration = Duration::from_secs(5);
+const PONG_TIMEOUT: Duration = Duration::from_secs(10);
+const MAX_QUEUED_FRAMES_AFTER_DEADLINE: usize = 32;
+
+pub(super) struct WsStream {
+    tx_command: mpsc::Sender<WsCommand>,
+    rx_message: mpsc::UnboundedReceiver<Result<Message, WsError>>,
+    pump_task: tokio::task::JoinHandle<()>,
+}
+
+struct WsCommand {
+    message: Message,
+    tx_result: oneshot::Sender<Result<(), WsError>>,
+}
+
+impl WsStream {
+    pub(super) fn new<S>(mut inner: S, mut network_changes: watch::Receiver<NetworkChange>) -> Self
+    where
+        S: Stream<Item = Result<Message, WsError>>
+            + Sink<Message, Error = WsError>
+            + Unpin
+            + Send
+            + 'static,
+    {
+        let (tx_command, mut rx_command) = mpsc::channel::<WsCommand>(32);
+        let (tx_message, rx_message) = mpsc::unbounded_channel();
+        let pump_task = tokio::spawn(async move {
+            let mut expected_pong: Option<Bytes> = None;
+            let mut heartbeat_at = Instant::now() + PROBE_INTERVAL;
+            let mut observing_network = true;
+            let mut expired_frames = 0;
+            let mut wake_epoch = network_changes.borrow_and_update().wake_epoch;
+            loop {
+                // Apply queued wake notifications before evaluating an old deadline.
+                tokio::select! {
+                    biased;
+                    changed = network_changes.changed(), if observing_network => {
+                        if changed.is_err() {
+                            observing_network = false;
+                        } else {
+                            let change = *network_changes.borrow_and_update();
+                            if change.wake_epoch != wake_epoch {
+                                // A pre-sleep probe must not consume the post-wake reply budget.
+                                wake_epoch = change.wake_epoch;
+                                expected_pong = None;
+                                heartbeat_at = Instant::now();
+                            } else if expected_pong.is_none() {
+                                // Coalesce network churn instead of extending a pending deadline.
+                                heartbeat_at = Instant::now();
+                            }
+                        }
+                    }
+                    message = inner.next() => {
+                        let Some(message) = message else { break };
+                        match message {
+                            Ok(Message::Ping(payload)) => {
+                                if let Err(error) = send(&mut inner, Message::Pong(payload)).await {
+                                    let _ = tx_message.send(Err(error));
+                                    break;
+                                }
+                            }
+                            Ok(Message::Pong(payload)) => {
+                                if expected_pong.as_ref() == Some(&payload) {
+                                    expected_pong = None;
+                                    heartbeat_at = Instant::now() + PROBE_INTERVAL;
+                                    tracing::debug!("websocket liveness pong received");
+                                }
+                            }
+                            Ok(message @ (Message::Text(_) | Message::Binary(_)
+                                | Message::Close(_) | Message::Frame(_))) => {
+                                let closed = matches!(message, Message::Close(_));
+                                if tx_message.send(Ok(message)).is_err() || closed { break; }
+                            }
+                            Err(error) => {
+                                let _ = tx_message.send(Err(error));
+                                break;
+                            }
+                        }
+                        // Drain already-ready frames so a queued Pong behind a server Ping
+                        // survives a scheduler pause. Bound the drain against frame floods.
+                        if expected_pong.is_some() && Instant::now() >= heartbeat_at {
+                            expired_frames += 1;
+                        } else {
+                            expired_frames = 0;
+                        }
+                        if expired_frames >= MAX_QUEUED_FRAMES_AFTER_DEADLINE {
+                            let _ = tx_message.send(Err(timeout_error(
+                                "websocket heartbeat timed out waiting for pong",
+                            )));
+                            break;
+                        }
+                    }
+                    _ = tokio::time::sleep_until(heartbeat_at) => {
+                        if expected_pong.is_some() {
+                            tracing::warn!("websocket heartbeat timed out waiting for pong");
+                            let _ = tx_message.send(Err(timeout_error(
+                                "websocket heartbeat timed out waiting for pong",
+                            )));
+                            break;
+                        }
+                        let nonce = Bytes::copy_from_slice(Uuid::new_v4().as_bytes());
+                        let deadline = Instant::now() + PONG_TIMEOUT;
+                        if let Err(error) = send(&mut inner, Message::Ping(nonce.clone())).await {
+                            let _ = tx_message.send(Err(error));
+                            break;
+                        }
+                        expected_pong = Some(nonce);
+                        expired_frames = 0;
+                        heartbeat_at = deadline;
+                        tracing::debug!("websocket liveness ping sent");
+                    }
+                    command = rx_command.recv() => {
+                        let Some(WsCommand { message, tx_result }) = command else { break };
+                        // Large requests retain their caller's write budget. The short deadline
+                        // is for control frames, not a new limit on prompt/image uploads.
+                        let result = inner.send(message).await;
+                        let failed = result.is_err();
+                        // Receiving was paused during this write. An old probe cannot judge
+                        // liveness while its Pong may be waiting in the socket's read buffer.
+                        expected_pong = None;
+                        heartbeat_at = Instant::now() + PROBE_INTERVAL;
+                        let _ = tx_result.send(result);
+                        if failed { break; }
+                    }
+
+                }
+            }
+        });
+        Self {
+            tx_command,
+            rx_message,
+            pump_task,
+        }
+    }
+
+    pub(super) async fn send(&self, message: Message) -> Result<(), WsError> {
+        let (tx_result, rx_result) = oneshot::channel();
+        if self
+            .tx_command
+            .send(WsCommand { message, tx_result })
+            .await
+            .is_err()
+        {
+            return Err(WsError::ConnectionClosed);
+        }
+        rx_result.await.unwrap_or(Err(WsError::ConnectionClosed))
+    }
+
+    pub(super) async fn next(&mut self) -> Option<Result<Message, WsError>> {
+        self.rx_message.recv().await
+    }
+}
+
+// A control-frame write must not strand the pump before its reply deadline starts.
+async fn send<S>(stream: &mut S, message: Message) -> Result<(), WsError>
+where
+    S: Sink<Message, Error = WsError> + Unpin,
+{
+    tokio::time::timeout(PONG_TIMEOUT, stream.send(message))
+        .await
+        .unwrap_or_else(|_| Err(timeout_error("websocket write timed out")))
+}
+
+fn timeout_error(message: &'static str) -> WsError {
+    WsError::Io(io::Error::new(io::ErrorKind::TimedOut, message))
+}
+
+impl Drop for WsStream {
+    fn drop(&mut self) {
+        self.pump_task.abort();
+    }
+}
+
+#[cfg(test)]
+#[path = "responses_websocket_stream_tests.rs"]
+mod tests;
