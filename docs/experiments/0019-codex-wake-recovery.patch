diff --git a/codex-rs/http-client/src/network_changes.rs b/codex-rs/http-client/src/network_changes.rs
new file mode 100644
index 0000000000..690f6766b6
--- /dev/null
+++ b/codex-rs/http-client/src/network_changes.rs
@@ -0,0 +1,178 @@
+//! Process-wide hints to recheck established transports after wake or a network change.
+
+use std::sync::OnceLock;
+use tokio::sync::watch;
+
+/// Snapshot carried with a network hint, preserving wake events when notifications coalesce.
+#[derive(Clone, Copy, Default)]
+pub struct NetworkChange {
+    /// Changes only after a system wake, which grants a fresh probe deadline.
+    pub wake_epoch: u64,
+}
+
+/// Subscribes to macOS wake and network changes. Other platforms retain periodic transport probes.
+///
+/// A change is a reason to check a connection, not proof that it failed or that the network is ready.
+pub fn network_changes() -> watch::Receiver<NetworkChange> {
+    static CHANGES: OnceLock<watch::Sender<NetworkChange>> = OnceLock::new();
+    CHANGES
+        .get_or_init(|| {
+            let (sender, _) = watch::channel(NetworkChange::default());
+            #[cfg(target_os = "macos")]
+            {
+                let changes = sender.clone();
+                if let Err(error) = std::thread::Builder::new()
+                    .name("codex-network-changes".into())
+                    .spawn(move || macos::observe(changes))
+                {
+                    tracing::warn!(%error, "network change observer unavailable; using periodic probes");
+                }
+            }
+            sender
+        })
+        .subscribe()
+}
+
+#[cfg(target_os = "macos")]
+mod macos {
+    use super::NetworkChange;
+    use std::ffi::c_void;
+    use std::ptr;
+    use system_configuration::core_foundation::array::CFArray;
+    use system_configuration::core_foundation::base::TCFType;
+    use system_configuration::core_foundation::runloop::CFRunLoop;
+    use system_configuration::core_foundation::runloop::CFRunLoopSource;
+    use system_configuration::core_foundation::runloop::CFRunLoopSourceRef;
+    use system_configuration::core_foundation::runloop::kCFRunLoopDefaultMode;
+    use system_configuration::core_foundation::string::CFString;
+    use system_configuration::dynamic_store::SCDynamicStoreBuilder;
+    use system_configuration::dynamic_store::SCDynamicStoreCallBackContext;
+    use tokio::sync::watch;
+
+    const CAN_SLEEP: u32 = 0xe0000270;
+    const WILL_SLEEP: u32 = 0xe0000280;
+    const DID_WAKE: u32 = 0xe0000300;
+
+    #[link(name = "IOKit", kind = "framework")]
+    unsafe extern "C" {
+        fn IORegisterForSystemPower(
+            context: *mut c_void,
+            port: *mut *mut c_void,
+            callback: unsafe extern "C" fn(*mut c_void, u32, u32, *mut c_void),
+            notifier: *mut u32,
+        ) -> u32;
+        fn IONotificationPortGetRunLoopSource(port: *mut c_void) -> CFRunLoopSourceRef;
+        fn IOAllowPowerChange(connection: u32, notification: isize) -> i32;
+        fn IODeregisterForSystemPower(notifier: *mut u32) -> i32;
+        fn IOServiceClose(connection: u32) -> i32;
+        fn IONotificationPortDestroy(port: *mut c_void);
+    }
+
+    struct PowerObserver {
+        changes: watch::Sender<NetworkChange>,
+        connection: u32,
+        port: *mut c_void,
+        notifier: u32,
+    }
+
+    impl Drop for PowerObserver {
+        fn drop(&mut self) {
+            // Deregister before the callback context is freed, even if run-loop setup failed.
+            unsafe {
+                if self.notifier != 0 {
+                    IODeregisterForSystemPower(&mut self.notifier);
+                }
+                if self.connection != 0 {
+                    IOServiceClose(self.connection);
+                }
+                if !self.port.is_null() {
+                    IONotificationPortDestroy(self.port);
+                }
+            }
+        }
+    }
+
+    unsafe extern "C" fn power_changed(
+        context: *mut c_void,
+        _service: u32,
+        message: u32,
+        argument: *mut c_void,
+    ) {
+        // IOKit invokes this only on the owning run loop while PowerObserver remains allocated.
+        let observer = unsafe { &*(context.cast::<PowerObserver>()) };
+        match message {
+            CAN_SLEEP | WILL_SLEEP => {
+                // Observe sleep without delaying or vetoing it.
+                unsafe { IOAllowPowerChange(observer.connection, argument as isize) };
+            }
+            DID_WAKE => {
+                tracing::debug!("macOS woke; rechecking model connections");
+                observer
+                    .changes
+                    .send_modify(|change| change.wake_epoch = change.wake_epoch.wrapping_add(1));
+            }
+            _ => {}
+        }
+    }
+
+    pub(super) fn observe(changes: watch::Sender<NetworkChange>) {
+        let run_loop = CFRunLoop::get_current();
+        let mode = unsafe { kCFRunLoopDefaultMode };
+        let store = SCDynamicStoreBuilder::new("Codex connection recovery")
+            .callback_context(SCDynamicStoreCallBackContext {
+                callout: |_, _, changes: &mut watch::Sender<NetworkChange>| {
+                    tracing::debug!("macOS network changed; rechecking model connections");
+                    changes.send_modify(|_| {});
+                },
+                info: changes.clone(),
+            })
+            .build();
+        let network_source = store.as_ref().and_then(|store| {
+            let keys = CFArray::<CFString>::from_CFTypes(&[]);
+            let patterns = CFArray::from_CFTypes(&[CFString::new(
+                "State:/Network/(Global|Service/[^/]+|Interface/[^/]+)/(IPv4|IPv6|DNS|Proxies|Link)",
+            )]);
+            store.set_notification_keys(&keys, &patterns)
+                .then(|| store.create_run_loop_source()).flatten()
+        });
+        if let Some(source) = &network_source {
+            run_loop.add_source(source, mode);
+        }
+
+        let mut power = Box::new(PowerObserver {
+            changes,
+            connection: 0,
+            port: ptr::null_mut(),
+            notifier: 0,
+        });
+        power.connection = unsafe {
+            IORegisterForSystemPower(
+                ptr::from_mut(power.as_mut()).cast(),
+                &mut power.port,
+                power_changed,
+                &mut power.notifier,
+            )
+        };
+        let power_source = if power.connection != 0 && !power.port.is_null() {
+            let source = unsafe { IONotificationPortGetRunLoopSource(power.port) };
+            if source.is_null() {
+                None
+            } else {
+                Some(unsafe { CFRunLoopSource::wrap_under_get_rule(source) })
+            }
+        } else {
+            None
+        };
+        if let Some(source) = &power_source {
+            run_loop.add_source(source, mode);
+        }
+        tracing::debug!(
+            wake = power_source.is_some(),
+            network = network_source.is_some(),
+            "macOS connection recovery observer registered"
+        );
+        if network_source.is_some() || power_source.is_some() {
+            CFRunLoop::run_current();
+        }
+    }
+}
