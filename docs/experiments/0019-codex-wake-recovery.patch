+use super::*;
+use pretty_assertions::assert_eq;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::io::DuplexStream;
+use tokio_tungstenite::WebSocketStream;
+use tokio_tungstenite::tungstenite::protocol::Role;
+
+async fn connection(capacity: usize) -> (WsStream, DuplexStream, watch::Sender<NetworkChange>) {
+    let (client, peer) = tokio::io::duplex(capacity);
+    let socket = WebSocketStream::from_raw_socket(client, Role::Client, None).await;
+    let (changes, receiver) = watch::channel(NetworkChange::default());
+    (WsStream::new(socket, receiver), peer, changes)
+}
+
+async fn read_frame(peer: &mut DuplexStream) -> (u8, Vec<u8>) {
+    let mut header = [0; 2];
+    peer.read_exact(&mut header).await.unwrap();
+    assert!(header[1] & 0x80 != 0, "client frames must be masked");
+    let length = usize::from(header[1] & 0x7f);
+    assert!(length < 126, "test expects a small control frame");
+    let mut mask = [0; 4];
+    peer.read_exact(&mut mask).await.unwrap();
+    let mut payload = vec![0; length];
+    peer.read_exact(&mut payload).await.unwrap();
+    for (index, byte) in payload.iter_mut().enumerate() {
+        *byte ^= mask[index % 4];
+    }
+    (header[0] & 0xf, payload)
+}
+
+async fn write_frame(peer: &mut DuplexStream, opcode: u8, payload: &[u8]) {
+    assert!(payload.len() < 126);
+    peer.write_all(&[0x80 | opcode, payload.len() as u8])
+        .await
+        .unwrap();
+    peer.write_all(payload).await.unwrap();
+    tokio::task::yield_now().await;
+}
+
+async fn expect_heartbeat_timeout(stream: &mut WsStream) {
+    let error = stream.next().await.unwrap().unwrap_err();
+    let WsError::Io(error) = error else {
+        panic!("expected I/O timeout")
+    };
+    assert_eq!(error.kind(), io::ErrorKind::TimedOut);
+    assert_eq!(
+        error.to_string(),
+        "websocket heartbeat timed out waiting for pong"
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn silent_peer_fails_without_waiting_for_model_idle_timeout() {
+    let (mut stream, mut peer, _changes) = connection(1024).await;
+    let started = Instant::now();
+    let (opcode, _) = read_frame(&mut peer).await;
+    assert_eq!(opcode, 9);
+    expect_heartbeat_timeout(&mut stream).await;
+    assert_eq!(started.elapsed(), PROBE_INTERVAL + PONG_TIMEOUT);
+}
+
+#[tokio::test(start_paused = true)]
+async fn quiet_healthy_peer_keeps_running_without_forwarding_control_frames() {
+    let (mut stream, mut peer, _changes) = connection(1024).await;
+    for _ in 0..5 {
+        let (opcode, nonce) = read_frame(&mut peer).await;
+        assert_eq!(opcode, 9);
+        write_frame(&mut peer, 10, &nonce).await;
+    }
+    write_frame(&mut peer, 1, b"model response").await;
+    assert_eq!(
+        stream.next().await.unwrap().unwrap(),
+        Message::text("model response")
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn wrong_pong_does_not_hide_a_dead_connection() {
+    let (mut stream, mut peer, _changes) = connection(1024).await;
+    let _ = read_frame(&mut peer).await;
+    write_frame(&mut peer, 10, b"unrelated pong").await;
+    expect_heartbeat_timeout(&mut stream).await;
+}
+
+#[tokio::test(start_paused = true)]
+async fn wake_replaces_the_old_probe_and_gives_a_fresh_reply_deadline() {
+    let (mut stream, mut peer, changes) = connection(1024).await;
+    let (_, old_nonce) = read_frame(&mut peer).await;
+    tokio::time::advance(Duration::from_secs(9)).await;
+    let woke_at = Instant::now();
+    changes.send_modify(|change| change.wake_epoch += 1);
+    let (opcode, fresh_nonce) = read_frame(&mut peer).await;
+    assert_eq!(opcode, 9);
+    assert_ne!(fresh_nonce, old_nonce);
+    assert_eq!(woke_at.elapsed(), Duration::ZERO);
+    write_frame(&mut peer, 10, &old_nonce).await;
+    expect_heartbeat_timeout(&mut stream).await;
+    assert_eq!(woke_at.elapsed(), PONG_TIMEOUT);
+}
+
+#[tokio::test(start_paused = true)]
+async fn healthy_connection_survives_wake_during_a_probe() {
+    let (mut stream, mut peer, changes) = connection(1024).await;
+    let _ = read_frame(&mut peer).await;
+    tokio::time::advance(Duration::from_secs(9)).await;
+    changes.send_modify(|change| change.wake_epoch += 1);
+    let (_, nonce) = read_frame(&mut peer).await;
+    tokio::time::advance(Duration::from_secs(8)).await;
+    write_frame(&mut peer, 10, &nonce).await;
+    write_frame(&mut peer, 1, b"still working").await;
+    assert_eq!(
+        stream.next().await.unwrap().unwrap(),
+        Message::text("still working")
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn server_ping_is_answered_but_does_not_acknowledge_the_client_probe() {
+    let (mut stream, mut peer, _changes) = connection(1024).await;
+    let _ = read_frame(&mut peer).await;
+    write_frame(&mut peer, 9, b"server probe").await;
+    assert_eq!(read_frame(&mut peer).await, (10, b"server probe".to_vec()));
+    expect_heartbeat_timeout(&mut stream).await;
+}
+
+#[tokio::test(start_paused = true)]
+async fn stalled_probe_write_is_bounded_instead_of_blocking_the_heartbeat_pump() {
+    let (mut stream, _peer, _changes) = connection(1).await;
+    let started = Instant::now();
+    let error = stream.next().await.unwrap().unwrap_err();
+    let WsError::Io(error) = error else {
+        panic!("expected I/O timeout")
+    };
+    assert_eq!(error.kind(), io::ErrorKind::TimedOut);
+    assert_eq!(started.elapsed(), PROBE_INTERVAL + PONG_TIMEOUT);
+}
+
+#[tokio::test(start_paused = true)]
+async fn slow_request_upload_retains_its_existing_write_budget() {
+    let (stream, mut peer, _changes) = connection(1).await;
+    let sending = tokio::spawn(async move { stream.send(Message::text("request")).await });
+    tokio::task::yield_now().await;
+    tokio::time::advance(Duration::from_secs(11)).await;
+    tokio::task::yield_now().await;
+    assert!(!sending.is_finished());
+    let mut wire = Vec::new();
+    peer.read_to_end(&mut wire).await.unwrap();
+    assert!(sending.await.unwrap().is_ok());
+}
+
+#[tokio::test(start_paused = true)]
+async fn dropping_a_connection_stops_its_heartbeat_task() {
+    let (stream, mut peer, _changes) = connection(1024).await;
+    drop(stream);
+    let mut byte = [0];
+    assert_eq!(peer.read(&mut byte).await.unwrap(), 0);
+}
+
+#[tokio::test(start_paused = true)]
+async fn closed_observer_retains_periodic_probes() {
+    let (mut stream, mut peer, changes) = connection(1024).await;
+    drop(changes);
+    assert_eq!(read_frame(&mut peer).await.0, 9);
+    expect_heartbeat_timeout(&mut stream).await;
+}
+
+#[tokio::test(start_paused = true)]
+async fn pending_wake_wins_over_an_expired_pre_sleep_probe() {
+    let (mut stream, mut peer, changes) = connection(1024).await;
+    let (_, old_nonce) = read_frame(&mut peer).await;
+    // Queue the notification without yielding, then expire the old timer before the pump runs.
+    changes.send_modify(|change| change.wake_epoch += 1);
+    tokio::time::advance(PONG_TIMEOUT + Duration::from_secs(20)).await;
+    let woke_at = Instant::now();
+    let (opcode, fresh_nonce) = read_frame(&mut peer).await;
+    assert_eq!(opcode, 9);
+    assert_ne!(fresh_nonce, old_nonce);
+    expect_heartbeat_timeout(&mut stream).await;
+    assert_eq!(woke_at.elapsed(), PONG_TIMEOUT);
+}
+
+#[tokio::test(start_paused = true)]
+async fn repeated_network_hints_do_not_extend_an_outstanding_probe() {
+    let (mut stream, mut peer, changes) = connection(1024).await;
+    let _ = read_frame(&mut peer).await;
+    let sent_at = Instant::now();
+    for _ in 0..4 {
+        tokio::time::advance(Duration::from_secs(2)).await;
+        changes.send_modify(|_| {});
+        tokio::task::yield_now().await;
+    }
+    expect_heartbeat_timeout(&mut stream).await;
+    assert_eq!(sent_at.elapsed(), PONG_TIMEOUT);
+}
+
+#[tokio::test(start_paused = true)]
+async fn network_change_probes_immediately_when_no_probe_is_pending() {
+    let (_stream, mut peer, changes) = connection(1024).await;
+    tokio::task::yield_now().await;
+    let changed_at = Instant::now();
+    changes.send_modify(|_| {});
+    assert_eq!(read_frame(&mut peer).await.0, 9);
+    assert_eq!(changed_at.elapsed(), Duration::ZERO);
+}
+
+#[tokio::test(start_paused = true)]
+async fn slow_upload_during_a_probe_does_not_expire_an_unread_pong() {
+    let (stream, mut peer, _changes) = connection(1).await;
+    let (_, nonce) = read_frame(&mut peer).await;
+    let sending = tokio::spawn(async move {
+        let result = stream.send(Message::text("request")).await;
