+    // Read the application frame header, proving its write started, then apply backpressure.
+    let mut first = [0; 1];
+    peer.read_exact(&mut first).await.unwrap();
+    assert_eq!(first[0], 0x81);
+    tokio::time::advance(PONG_TIMEOUT + Duration::from_secs(1)).await;
+    assert!(!sending.is_finished());
+    let mut rest = [0; 12];
+    peer.read_exact(&mut rest).await.unwrap();
+    let (mut stream, result) = sending.await.unwrap();
+    assert!(result.is_ok());
+    write_frame(&mut peer, 10, &nonce).await;
+    write_frame(&mut peer, 1, b"upload completed").await;
+    assert_eq!(
+        stream.next().await.unwrap().unwrap(),
+        Message::text("upload completed")
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn queued_matching_pong_wins_over_a_deadline_after_a_scheduler_pause() {
+    let (mut stream, mut peer, _changes) = connection(1024).await;
+    let (_, nonce) = read_frame(&mut peer).await;
+    // These writes fit in the duplex buffer without yielding to the pump.
+    peer.write_all(&[0x8a, nonce.len() as u8]).await.unwrap();
+    peer.write_all(&nonce).await.unwrap();
+    tokio::time::advance(PONG_TIMEOUT + Duration::from_secs(1)).await;
+    write_frame(&mut peer, 1, b"still responsive").await;
+    assert_eq!(
+        stream.next().await.unwrap().unwrap(),
+        Message::text("still responsive")
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn queued_unrelated_pongs_do_not_starve_an_expired_probe() {
+    let (mut stream, mut peer, _changes) = connection(1024).await;
+    let _ = read_frame(&mut peer).await;
+    for _ in 0..20 {
+        peer.write_all(&[0x8a, 1, 0]).await.unwrap();
+    }
+    tokio::time::advance(PONG_TIMEOUT).await;
+    expect_heartbeat_timeout(&mut stream).await;
+}
+
+#[tokio::test(start_paused = true)]
+async fn queued_server_ping_before_matching_pong_survives_a_scheduler_pause() {
+    let (mut stream, mut peer, _changes) = connection(1024).await;
+    let (_, nonce) = read_frame(&mut peer).await;
+    peer.write_all(&[0x89, 1, 7, 0x8a, nonce.len() as u8])
+        .await
+        .unwrap();
+    peer.write_all(&nonce).await.unwrap();
+    tokio::time::advance(PONG_TIMEOUT + Duration::from_secs(1)).await;
+    assert_eq!(read_frame(&mut peer).await, (10, vec![7]));
+    write_frame(&mut peer, 1, b"still responsive").await;
+    assert_eq!(
+        stream.next().await.unwrap().unwrap(),
+        Message::text("still responsive")
+    );
+}
