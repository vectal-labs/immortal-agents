+#[tokio::test]
+async fn confirmed_progress_survives_a_transient_persistence_failure() {
+    let (mut session, turn_context) = make_session_and_context().await;
+    session.services.state_db = crate::init_state_db(&turn_context.config).await;
+    let mut state = super::ResponsesStreamRetryState::default();
+    state.record_recovery_started(&session, &turn_context).await;
+    let recovery_id = state.recovery_id;
+    session
+        .services
+        .state_db
+        .as_ref()
+        .expect("state database")
+        .close()
+        .await;
+    let message = serde_json::from_value(serde_json::json!({
+        "type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "fixture-progress"}]
+    })).expect("valid assistant item");
+    state
+        .observe_completed_item(&message, &session, &turn_context)
+        .await;
+    assert_eq!(state.recovery_id, recovery_id);
+    assert!(state.progress_observed);
+    session.services.state_db = crate::init_state_db(&turn_context.config).await;
+    state.finish_observation(&session, &turn_context).await;
+    assert_eq!(state.recovery_id, None);
+    let rows = session
+        .services
+        .state_db
+        .as_ref()
+        .expect("reopened database")
+        .query_logs(&codex_state::LogQuery {
+            thread_ids: vec![session.thread_id().to_string()],
+            ..Default::default()
+        })
+        .await
+        .expect("persisted events");
+    assert_eq!(rows.len(), 2);
+    let logs = rows
+        .iter()
+        .map(|row| row.message.as_deref().unwrap_or_default())
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(logs.contains("recovery_confirmed"));
+    assert!(!logs.contains("recovery_unconfirmed"));
+}
