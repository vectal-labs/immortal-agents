+#[tokio::test]
+async fn recovery_reporting_requires_progress_and_keeps_one_id_per_episode() {
+    let (mut session, turn_context) = make_session_and_context().await;
+    session.services.state_db = crate::init_state_db(&turn_context.config).await;
+    let state_db = session
+        .services
+        .state_db
+        .as_ref()
+        .expect("state database")
+        .clone();
+    let mut state = super::ResponsesStreamRetryState::default();
+    let message = serde_json::from_value(serde_json::json!({
+        "type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "private-fixture-output"}]
+    })).expect("valid response item");
+    state
+        .observe_completed_item(&message, &session, &turn_context)
+        .await;
+    state.record_recovery_started(&session, &turn_context).await;
+    let first_id = state.recovery_id.expect("recovery started");
+    state.record_recovery_started(&session, &turn_context).await;
+    assert_eq!(state.recovery_id, Some(first_id));
+    for item in [
+        serde_json::json!({"type": "message", "role": "user", "content": [{"type": "output_text", "text": "input"}]}),
+        serde_json::json!({"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "  "}]}),
+        serde_json::json!({"type": "reasoning", "summary": []}),
+        serde_json::json!({"type": "compaction", "encrypted_content": ""}),
+    ] {
+        let item = serde_json::from_value(item).expect("valid response item");
+        state
+            .observe_completed_item(&item, &session, &turn_context)
+            .await;
+        assert_eq!(state.recovery_id, Some(first_id));
+    }
+    state
+        .observe_completed_item(&message, &session, &turn_context)
+        .await;
+    state
+        .observe_completed_item(&message, &session, &turn_context)
+        .await;
+    assert_eq!(state.recovery_id, None);
+    state.record_recovery_started(&session, &turn_context).await;
+    let second_id = state.recovery_id.expect("new recovery started");
+    assert_ne!(second_id, first_id);
+    let tool = serde_json::from_value(serde_json::json!({
+        "type": "function_call", "name": "fixture_tool", "arguments": "private-fixture-arguments", "call_id": "call_fixture"
+    })).expect("valid tool call");
+    state
+        .observe_completed_item(&tool, &session, &turn_context)
+        .await;
+    assert_eq!(state.recovery_id, None);
+    state.record_recovery_started(&session, &turn_context).await;
+    state.finish_observation(&session, &turn_context).await;
+    state
+        .observe_completed_item(&message, &session, &turn_context)
+        .await;
+    state.record_recovery_started(&session, &turn_context).await;
+    let compaction = serde_json::from_value(serde_json::json!({
+        "type": "compaction", "encrypted_content": "private-fixture-compaction"
+    }))
+    .expect("valid compaction item");
+    state
+        .observe_completed_item(&compaction, &session, &turn_context)
+        .await;
+    let rows = state_db
+        .query_logs(&codex_state::LogQuery {
+            thread_ids: vec![session.thread_id().to_string()],
+            ..Default::default()
+        })
+        .await
+        .expect("persisted recovery events");
+    assert_eq!(rows.len(), 8);
+    let logs = rows
+        .iter()
+        .map(|row| row.message.as_deref().unwrap_or_default())
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert_eq!(logs.matches("recovery_started").count(), 4);
+    assert_eq!(logs.matches("recovery_confirmed").count(), 3);
+    assert_eq!(logs.matches("recovery_unconfirmed").count(), 1);
+    assert_eq!(logs.matches(&first_id.to_string()).count(), 2);
+    assert_eq!(logs.matches(&second_id.to_string()).count(), 2);
+    assert!(!logs.contains("private-fixture"));
+    assert!(!logs.contains("fixture_tool"));
+    assert!(
+        rows.iter()
+            .all(|row| row.target == "codex_core::recovery_reporting")
+    );
+}
