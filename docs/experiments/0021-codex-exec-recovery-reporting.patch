+
+impl ResponsesStreamRetryState {
+    async fn record_recovery_started(&mut self, sess: &Session, turn_context: &TurnContext) {
+        if self.recovery_id.is_none() {
+            let recovery_id = uuid::Uuid::new_v4();
+            self.recovery_id = Some(recovery_id);
+            self.progress_observed = false;
+            persist_recovery_event(sess, turn_context, recovery_id, "recovery_started").await;
+        }
+    }
+
+    pub(crate) async fn finish_observation(&mut self, sess: &Session, turn_context: &TurnContext) {
+        let event = if self.progress_observed {
+            "recovery_confirmed"
+        } else {
+            "recovery_unconfirmed"
+        };
+        if let Some(recovery_id) = self.recovery_id
+            && persist_recovery_event(sess, turn_context, recovery_id, event).await
+        {
+            self.recovery_id = None;
+        }
+    }
+
+    pub(crate) async fn observe_completed_item(
+        &mut self,
+        item: &ResponseItem,
+        sess: &Session,
+        turn_context: &TurnContext,
+    ) {
+        if self.recovery_id.is_none() {
+            return;
+        }
+        let assistant_text = matches!(item, ResponseItem::Message { role, content, .. }
+        if role == "assistant" && content.iter().any(|part| {
+            matches!(part, ContentItem::OutputText { text } if !text.trim().is_empty())
+        }));
+        let tool_call = matches!(
+            item,
+            ResponseItem::FunctionCall { .. }
+                | ResponseItem::CustomToolCall { .. }
+                | ResponseItem::LocalShellCall { .. }
+                | ResponseItem::ToolSearchCall { .. }
+                | ResponseItem::WebSearchCall { .. }
+                | ResponseItem::ImageGenerationCall { .. }
+        );
+        let compaction = matches!(item, ResponseItem::Compaction { encrypted_content, .. }
+            if !encrypted_content.trim().is_empty());
+        if assistant_text || tool_call || compaction {
+            self.progress_observed = true;
+            self.finish_observation(sess, turn_context).await;
+        }
+    }
+}
+
+// Bypass the best-effort tracing queue: successful recoveries must survive log saturation.
+// Ephemeral sessions store only these operational IDs, never conversation content.
+async fn persist_recovery_event(
+    sess: &Session,
+    turn_context: &TurnContext,
+    recovery_id: uuid::Uuid,
+    event: &str,
+) -> bool {
+    let state_db = match &sess.services.state_db {
+        Some(state_db) => Some(state_db.clone()),
+        None => crate::init_state_db(&turn_context.config).await,
+    };
+    let Some(state_db) = state_db else {
+        return false;
+    };
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap_or_default();
+    let entry = codex_state::LogEntry {
+        ts: now.as_secs() as i64,
+        ts_nanos: now.subsec_nanos() as i64,
+        level: "INFO".to_string(),
+        target: "codex_core::recovery_reporting".to_string(),
+        message: None,
+        feedback_log_body: Some(format!(
+            "{event} turn_id={} recovery_id={recovery_id}",
+            turn_context.sub_id
+        )),
+        thread_id: Some(sess.thread_id().to_string()),
+        process_uuid: None,
+        module_path: None,
+        file: None,
+        line: None,
+    };
+    match state_db.insert_log(&entry).await {
+        Ok(()) => true,
+        Err(err) => {
+            warn!(error = %err, "failed to persist recovery event");
+            false
         }
     }
 }
